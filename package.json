{
  "name": "tuerce",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter tuerce-juego --filter tuerce-sala dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "check": "biome check . && pnpm -r typecheck && tsc --noEmit -p convex",
    "format": "biome check --write .",
    "capturas": "node scripts/capturas.mjs",
    "convex:dev": "convex dev",
    "sala:dev": "pnpm --filter tuerce-sala dev",
    "sala:test": "pnpm --filter tuerce-sala test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "convex": "^1.49.0",
    "playwright": "1.65.0",
    "typescript": "^5.9.3"
  }
}
