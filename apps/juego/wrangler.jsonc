// El juego se publica como un Worker que solo sirve archivos estáticos (la carpeta dist/ de Vite).
// Producción: `wrangler deploy` (lo hace la revisión automática al entrar a main).
// Vista previa: `wrangler versions upload --preview-alias pr-N` → https://pr-N-tuerce.<tu-subdominio>.workers.dev
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tuerce",
  "compatibility_date": "2026-10-01",
  "preview_urls": true,
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" }
}
